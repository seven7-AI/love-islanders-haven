server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # nginx drops server-level add_header lines in any location that sets its own, so every location includes these.
  include /etc/nginx/conf.d/security-headers.inc;

  # Fingerprinted build assets never change.
  location /assets/ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Single-page app: unknown paths serve index.html (never cached, so new releases load immediately).
  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }
}
