# Copy to backend/.env for running the API outside Docker.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/love_islander
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:8080"]
# Supabase Auth: project URL (tokens verified with its JWKS), or the legacy JWT secret for HS256 projects.
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=
# Server-side Supabase key for Storage (photo uploads/deletes). Keep secret; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Local seed tool only (stock photos from Pexels); never needed by the running API.
# PEXELS_API_KEY=
