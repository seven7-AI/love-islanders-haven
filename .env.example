# Frontend (Vite) — values are embedded in the browser bundle; never put server secrets here.
# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable (anon) key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Love Islander API base URL (backend/), e.g. http://localhost:8000
VITE_API_URL=http://localhost:8000
